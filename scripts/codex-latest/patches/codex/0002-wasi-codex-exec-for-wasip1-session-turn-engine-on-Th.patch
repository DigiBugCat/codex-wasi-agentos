+// ---- wasm32-wasip1 (agentOS) -------------------------------------------------
+// `--session-turn` runs the agentOS NDJSON engine; the apply-patch self-invocation is
+// handled here; any other invocation runs the normal `codex exec` CLI above on a
+// current-thread runtime (no codex-arg0 worker thread / current_exe on wasip1).
+
+#[cfg(target_os = "wasi")]
+mod session_turn_wasi;
+
+#[cfg(target_os = "wasi")]
+pub fn wasi_main() -> anyhow::Result<()> {
+    let args: Vec<String> = std::env::args().collect();
+    match args.get(1).map(String::as_str) {
+        Some("--session-turn") => session_turn_wasi::run(),
+        // Same contract as codex-arg0's apply-patch self-invocation.
+        Some(arg) if arg == codex_apply_patch::CODEX_CORE_APPLY_PATCH_ARG1 => {
+            let patch = args.get(2).map(String::as_str).unwrap_or_default();
+            let mut stdout = std::io::stdout();
+            let mut stderr = std::io::stderr();
+            let cwd = codex_utils_absolute_path::AbsolutePathBuf::current_dir()?.into();
+            let runtime = tokio::runtime::Builder::new_current_thread()
+                .enable_time()
+                .build()?;
+            let ok = runtime
+                .block_on(codex_apply_patch::apply_patch(
+                    patch,
+                    &cwd,
+                    &mut stdout,
+                    &mut stderr,
+                    codex_exec_server::LOCAL_FS.as_ref(),
+                    /*sandbox*/ None,
+                ))
+                .is_ok();
+            std::process::exit(if ok { 0 } else { 1 });
+        }
+        _ => wasi_native_main(),
+    }
+}
+
+/// `codex exec ...` without codex-arg0's dispatcher, which needs a worker thread
+/// and `current_exe()` (neither exists on wasip1).
+#[cfg(target_os = "wasi")]
+fn wasi_native_main() -> anyhow::Result<()> {
+    use clap::Parser;
+
+    #[derive(Parser, Debug)]
+    struct TopCli {
+        #[clap(flatten)]
+        config_overrides: codex_utils_cli::CliConfigOverrides,
+
+        #[clap(flatten)]
+        inner: Cli,
+    }
+
+    let top_cli = TopCli::parse();
+    let mut inner = top_cli.inner;
+    inner
+        .config_overrides
+        .prepend_root_overrides(top_cli.config_overrides);
+    let paths = codex_arg0::Arg0DispatchPaths {
+        codex_self_exe: Some(session_turn_wasi::resolve_self_exe()),
+        ..Default::default()
+    };
+    tokio::runtime::Builder::new_current_thread()
+        .enable_time()
+        .build()?
+        .block_on(run_main(inner, paths))
+}
