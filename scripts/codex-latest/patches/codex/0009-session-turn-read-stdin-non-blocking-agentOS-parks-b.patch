+static T0: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+
+/// CODEX_WASI_TIMING=1: emit `{"type":"timing","phase":..,"ms":..}` events with guest
+/// monotonic time (guest wall-clock log timestamps are frozen in the agentOS VM).
+fn timing(phase: &str) {
+    if std::env::var_os("CODEX_WASI_TIMING").is_some() {
+        let ms = T0.get_or_init(std::time::Instant::now).elapsed().as_millis() as u64;
+        emit(json!({ "type": "timing", "phase": phase, "ms": ms }));
+    }
+}
+
 fn emit(v: Value) {
     let mut out = std::io::stdout();
     let _ = writeln!(out, "{v}");
     let _ = out.flush();
 }
 
-fn read_line() -> Option<String> {
-    let mut s = String::new();
-    match std::io::stdin().read_line(&mut s) {
-        Ok(0) | Err(_) => None,
-        Ok(_) => Some(s),
+/// Line reader over fd 0 that never parks in a blocking read.
+///
+/// agentOS 0.4.1 services a blocking guest `read(0)` by parking `__kernel_stdin_read` for
+/// a 10 s slice (`KERNEL_WAIT_SLICE_MS` in the WASM runner), and a host
+/// `vm.process.writeStdin()` does not wake the parked read: the data is only seen when
+/// the slice expires. Measured with build/codex-latest/stdin-probe: blocking reads return
+/// 10,011 ms after the write, O_NONBLOCK reads within ~5 ms. Every permission_response
+/// (apply_patch, exec approvals) therefore cost 10 s. Read non-blocking and poll instead;
+/// the tokio sleep also lets codex-core tasks run while we wait for the host.
+struct StdinLines {
+    buf: Vec<u8>,
+    eof: bool,
+}
+
+impl StdinLines {
+    fn new() -> Self {
+        // SAFETY: plain fcntl on fd 0.
+        unsafe {
+            let flags = libc::fcntl(0, libc::F_GETFL);
+            if flags >= 0 {
+                libc::fcntl(0, libc::F_SETFL, flags | libc::O_NONBLOCK);
+            }
+        }
+        StdinLines { buf: Vec::new(), eof: false }
+    }
+
+    async fn next_line(&mut self) -> Option<String> {
+        let mut idle = std::time::Duration::from_millis(2);
+        loop {
+            if let Some(pos) = self.buf.iter().position(|b| *b == b'\n') {
+                let line: Vec<u8> = self.buf.drain(..=pos).collect();
+                return Some(String::from_utf8_lossy(&line).into_owned());
+            }
+            if self.eof {
+                if self.buf.is_empty() {
+                    return None;
+                }
+                let rest = std::mem::take(&mut self.buf);
+                return Some(String::from_utf8_lossy(&rest).into_owned());
+            }
+            let mut chunk = [0u8; 8192];
+            // SAFETY: reads into a local buffer of the given length.
+            let n = unsafe { libc::read(0, chunk.as_mut_ptr().cast(), chunk.len()) };
+            if n > 0 {
+                self.buf.extend_from_slice(&chunk[..n as usize]);
+                idle = std::time::Duration::from_millis(2);
+            } else if n == 0 {
+                self.eof = true;
+            } else {
+                match std::io::Error::last_os_error().kind() {
+                    std::io::ErrorKind::WouldBlock => {
+                        tokio::time::sleep(idle).await;
+                        idle = (idle * 2).min(std::time::Duration::from_millis(25));
+                    }
+                    std::io::ErrorKind::Interrupted => {}
+                    _ => self.eof = true,
+                }
+            }
+        }
     }
 }
 
